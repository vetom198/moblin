#include "User.xcconfig"

// The upstream Moblin release this fork descends from. It is not the app's
// version, it is the answer to "which Moblin is this code based on", which is
// the first thing anyone needs when a bug turns out to be upstream's. Update it
// on every rebase.
MOBLIN_UPSTREAM_VERSION = 33.5.0

// CTLiveGo's own version, deliberately independent of upstream: what ships to a
// race crew is this fork, and a number tracking Moblin's releases would say
// nothing about what changed for them. See docs/ctlivego-versioning.md.
// Set here rather than per target so the app and its extensions always match,
// which the App Store requires.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
